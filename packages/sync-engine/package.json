{
  "name": "@astracollab/sync-engine",
  "version": "0.0.1-beta.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./helpers/files": {
      "types": "./dist/helpers/files.d.ts",
      "import": "./dist/helpers/files.js",
      "require": "./dist/helpers/files.cjs"
    },
    "./model-types": {
      "types": "./dist/model-types.d.ts",
      "import": "./dist/model-types.js",
      "require": "./dist/model-types.cjs"
    },
    "./resources/files": {
      "types": "./dist/resources/files.d.ts",
      "import": "./dist/resources/files.js",
      "require": "./dist/resources/files.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.js",
      "require": "./dist/queries/index.cjs"
    },
    "./queries/files": {
      "types": "./dist/queries/files.d.ts",
      "import": "./dist/queries/files.js",
      "require": "./dist/queries/files.cjs"
    },
    "./mutators/client": {
      "types": "./dist/mutators/client.d.ts",
      "import": "./dist/mutators/client.js",
      "require": "./dist/mutators/client.cjs"
    },
    "./mutators/server": {
      "types": "./dist/mutators/server.d.ts",
      "import": "./dist/mutators/server.js",
      "require": "./dist/mutators/server.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@rocicorp/zero": "^0.26.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rocicorp/zero": "^0.26.2",
    "typescript": "^5.8.2",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "zod": "^4.4.3"
  }
}
