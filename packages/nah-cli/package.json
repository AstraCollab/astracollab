{
  "name": "@astracollab/nah",
  "version": "0.0.1-beta.0",
  "description": "nah — not another harness, the CLI. A fast, minimal coding-agent terminal (Pi-style): streaming agent loop, capped tools, JSONL sessions, slash commands.",
  "type": "module",
  "bin": {
    "nah": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "install.sh",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "license": "MIT",
  "author": "AstraCollab",
  "repository": {
    "type": "git",
    "url": "https://github.com/astracollab/astracollab.git",
    "directory": "packages/nah-cli"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "tui",
    "ai-sdk",
    "pi",
    "opencode"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "compile:binaries": "./scripts/compile-binaries.sh",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@astracollab/not-another-harness": "workspace:*",
    "@blaxel/core": "^0.2.95",
    "ai": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
