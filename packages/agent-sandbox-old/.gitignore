# This repo uses pnpm-lock.yaml; an npm-generated root lockfile breaks mixed workflows.
package-lock.json
# Per-package npm lockfiles under a pnpm workspace are easy to corrupt with
# hybrid installs; use pnpm-lock.yaml at the repo root for reproducible installs.
packages/*/package-lock.json
