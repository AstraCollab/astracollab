{
  "name": "@astracollab/ai",
  "version": "0.0.1-beta",
  "private": false,
  "description": "AstraCollab AI provider SDKs — OpenAI-compatible Cursor Composer 2.5 inference and Vercel AI SDK integration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cursor": {
      "types": "./dist/cursor/index.d.ts",
      "import": "./dist/cursor/index.js",
      "require": "./dist/cursor/index.cjs"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js",
      "require": "./dist/workflows/index.cjs"
    },
    "./workflows/mastra": {
      "types": "./dist/workflows/mastra/index.d.ts",
      "import": "./dist/workflows/mastra/index.js",
      "require": "./dist/workflows/mastra/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "AstraCollab",
  "repository": {
    "type": "git",
    "url": "https://github.com/astracollab/astracollab.git",
    "directory": "packages/ai"
  },
  "keywords": [
    "astracollab",
    "cursor",
    "composer",
    "ai-sdk",
    "openai-compatible",
    "inference"
  ],
  "scripts": {
    "build": "node scripts/build-entries.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": "^0.2.0 || ^1.0.0",
    "@mastra/core": ">=1.35.0",
    "ai": "^4.0.0 || ^5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": { "optional": true },
    "@mastra/core": { "optional": true },
    "ai": { "optional": true },
    "zod": { "optional": true }
  },
  "dependencies": {
    "ofetch": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^1.0.39",
    "@mastra/core": "1.35.0",
    "@types/node": "^20.11.30",
    "ai": "^5.0.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.9",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
