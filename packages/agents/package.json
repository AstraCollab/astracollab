		"access": "public",
		"provenance": false
	},
	"license": "MIT",
	"author": "AstraCollab",
	"repository": {
		"type": "git",
		"url": "https://github.com/astracollab/astracollab.git",
		"directory": "packages/agents"
	},
	"scripts": {
		"build": "vite build",
