{
	"name": "cogmemory",
	"version": "0.0.1-beta.2",
	"description": "Cognitive Memory for agents: a typed client for the service, plus the deterministic cognitive layer to run in-process. No model in the retrieval path.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/cognitive-memory.cjs",
	"module": "./dist/cognitive-memory.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/cognitive-memory.js",
			"require": "./dist/cognitive-memory.cjs"
		},
		"./arbiter": {
			"types": "./dist/arbiter.d.ts",
			"import": "./dist/arbiter.js",
			"require": "./dist/arbiter.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "src", "README.md"],
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"author": "AstraCollab",
	"repository": {
		"type": "git",
		"url": "https://github.com/astracollab/astracollab.git",
		"directory": "packages/cognitive-memory"
	},
	"keywords": [
		"memory",
		"llm",
		"agent",
		"context",
		"cogmem",
		"cognitive-memory",
		"sdk",
		"ai"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "tsc --noEmit",
		"check-types": "tsc --noEmit"
	},
	"peerDependencies": {
		"ai": "^7.0.0",
		"ofetch": "^1.4.1",
		"zod": "^3.25.76 || ^4.1.8"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"ai": "^7.0.127",
		"ofetch": "^1.4.1",
		"typescript": "^5.8.3",
		"vite": "^5.4.19",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^3.2.4",
		"zod": "^4.3.6"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	}
}
