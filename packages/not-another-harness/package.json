{
  "name": "@astracollab/not-another-harness",
  "version": "0.0.1-beta.1",
  "description": "not another harness \u2014 a small, transparent coding-agent harness. Pi-style minimal capped tools, a manual agent loop with streaming events, token budgets, mid-run compaction, and JSONL sessions. Bring any AI SDK v5 model.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "license": "MIT",
  "author": "AstraCollab",
  "repository": {
    "type": "git",
    "url": "https://github.com/astracollab/astracollab.git",
    "directory": "packages/not-another-harness"
  },
  "keywords": [
    "agent",
    "harness",
    "coding-agent",
    "ai-sdk",
    "llm",
    "pi-style"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.5",
    "@types/node": "^22.19.0",
    "ai": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.21",
    "@astracollab/cogmem": "workspace:^",
    "ai": "^7.0.127"
  }
}
