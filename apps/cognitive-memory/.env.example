# Cognitive Memory — every value is optional in development.
# Copy to .env.local and change what you need.

# --- storage -------------------------------------------------------------
# Where the database lives: a local SQLite file, or a remote Turso database
# reached over HTTP. The directory of a local file is created on first
# connection. A URL always wins over the path, whichever name it comes under.
COGNITIVE_MEMORY_DATABASE_PATH=.cognitive-memory/cognitive-memory.sqlite
# A remote database. COGNITIVE_MEMORY_DATABASE_URL wins over DATABASE_URL.
# COGNITIVE_MEMORY_DATABASE_URL=libsql://your-database.your-region.turso.io
# DATABASE_URL=libsql://your-database.your-region.turso.io
# The token a remote database is reached with. TURSO_AUTH_TOKEN, or
# COGNITIVE_MEMORY_DATABASE_AUTH_TOKEN, or DATABASE_AUTH_TOKEN.
# TURSO_AUTH_TOKEN=

# --- injection budget ----------------------------------------------------
# Ceiling on everything injected into one prompt, index and bodies together.
# When the cap bites the response reports `truncated: true`.
COGNITIVE_MEMORY_MAX_TOTAL_TOKENS=2000
# Index lines per prompt, so a large store cannot fill the window.
COGNITIVE_MEMORY_MAX_INDEX_ITEMS=60
# Default result count for POST /v1/recall.
COGNITIVE_MEMORY_DEFAULT_RECALL_LIMIT=8

# --- optional model-backed extraction ------------------------------------
# With no key the service still learns: deterministic patterns run first, and
# GET /api/v1/health reports `extractor: "rules-only"`.
# Any OpenAI-compatible endpoint works, including a local gateway.
# COGNITIVE_MEMORY_MODEL_API_KEY=sk-...
# COGNITIVE_MEMORY_MODEL_BASE_URL=http://localhost:11434/v1
# COGNITIVE_MEMORY_MODEL_NAME=gpt-4o-mini

# --- auth ----------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The URL this deployment is served from. Left unset it is read from the
# request — the forwarded host, and the scheme that host is served on — which
# is right for a deployment that answers on one host. Set it when the app is
# reached on a different name than the request carries, or when the proxy in
# front of it does not forward the public scheme.
# BETTER_AUTH_URL=https://cogmem.astracollab.app
# The browser side of the same question. Left unset the dashboard talks to the
# origin that served it, which is right in every single-host deployment.
# NEXT_PUBLIC_COGNITIVE_MEMORY_URL=

# --- keys ----------------------------------------------------------------
# The environment half of issued API keys: cmi_prod_… or cmi_dev_…
# COGNITIVE_MEMORY_ENV=dev
