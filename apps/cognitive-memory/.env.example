# Cognitive Memory — every value is optional in development.
# Copy to .env.local and change what you need.

# --- storage -------------------------------------------------------------
# SQLite file. The directory is created on first connection.
COGNITIVE_MEMORY_DATABASE_PATH=.cognitive-memory/cognitive-memory.sqlite

# --- injection budget ----------------------------------------------------
# Ceiling on everything injected into one prompt, index and bodies together.
# When the cap bites the response reports `truncated: true`.
COGNITIVE_MEMORY_MAX_TOTAL_TOKENS=2000
# Index lines per prompt, so a large store cannot fill the window.
COGNITIVE_MEMORY_MAX_INDEX_ITEMS=60
# Default result count for POST /v1/recall.
COGNITIVE_MEMORY_DEFAULT_RECALL_LIMIT=8

# --- optional model-backed extraction ------------------------------------
# With no key the service still learns: deterministic patterns run first, and
# GET /api/v1/health reports `extractor: "rules-only"`.
# Any OpenAI-compatible endpoint works, including a local gateway.
# COGNITIVE_MEMORY_MODEL_API_KEY=sk-...
# COGNITIVE_MEMORY_MODEL_BASE_URL=http://localhost:11434/v1
# COGNITIVE_MEMORY_MODEL_NAME=gpt-4o-mini

# --- auth ----------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# --- keys ----------------------------------------------------------------
# The environment half of issued API keys: cmi_prod_… or cmi_dev_…
# COGNITIVE_MEMORY_ENV=dev
