# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
.nah/workflows/**/*
# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Agent-generated memory files.
# The agent has a trained habit of writing recall notes to .claude/memory/ when
# asked to remember something. Nothing in this repo reads them, so committing one
# only risks putting agent chatter into history. Force-add if you ever adopt the
# convention deliberately.
# The leading ** is required: a pattern containing a slash is anchored to the
# directory holding this file, so a bare `.claude/memory/` would only ever match
# the repository root and let packages/*/.claude/memory/ through.
**/.claude/memory/

# Testing
coverage
packages/not-another-harness/evals/live-results.jsonl

# Turbo
.turbo

# Vercel
.vercel

